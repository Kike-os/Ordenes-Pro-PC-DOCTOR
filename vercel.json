{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__path=/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/stability",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/stability-night",
      "schedule": "0 22 * * *"
    }
  ]
}
