{
  "rewrites": [
    {
      "source": "/api/backups/run",
      "destination": "/api/backup?__path=/api/backups/run"
    },
    {
      "source": "/api/cron/backup(.*)",
      "destination": "/api/backup?__path=/api/cron/backup$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?__path=/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    },
    "api/backup.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/stability",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/stability-night",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/backup-reintento-1",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/backup-reintento-2",
      "schedule": "0 12 * * *"
    }
  ]
}
