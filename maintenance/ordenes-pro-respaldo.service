[Unit]
Description=Respaldo diario de Órdenes Pro: copia local verificada + respaldo cifrado en MEGA
After=network-online.target ordenes-mega.service

[Service]
Type=oneshot
WorkingDirectory=/home/admin-red/Work/Ordenes-Pro-PC-DOCTOR
Environment=PATH=/home/admin-red/.local/share/mise/installs/node/26.10.0/bin:/usr/local/bin:/usr/bin
UMask=0077
ExecStart=/home/admin-red/.local/share/mise/installs/node/26.10.0/bin/vercel env run -e production -- /home/admin-red/.local/share/ordenes-pro/venv/bin/python maintenance/backup-cloud.py
