# MEGAcmd OFICIAL de MEGA Limited (paquete para Ubuntu 24.04) para el agente de respaldos de Órdenes Pro (1.5.311).
# Se usa un contenedor porque el paquete de MEGA para Arch exige ffmpeg 7 y el sistema de la oficina tiene ffmpeg 9.
# La clave del repositorio se comprueba por su huella antes de confiar en ella (MegaLimited <support@mega.co.nz>, válida hasta 2032).
# Tras instalar, el propio paquete de MEGA deja su repositorio y su clave: se retira la declaración temporal para no duplicarla.
FROM docker.io/library/ubuntu:24.04
ARG MEGA_FPR=B01C811880480C854C73EC7E1A664B787094A482
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && curl -fsSL https://mega.nz/linux/repo/xUbuntu_24.04/Release.key -o /tmp/mega.key \
 && gpg --show-keys --with-colons /tmp/mega.key | grep -q "^fpr:::::::::${MEGA_FPR}:" \
 && gpg --dearmor -o /usr/share/keyrings/meganz.gpg /tmp/mega.key \
 && echo "deb [signed-by=/usr/share/keyrings/meganz.gpg] https://mega.nz/linux/repo/xUbuntu_24.04/ ./" > /etc/apt/sources.list.d/meganz.list \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends megacmd \
 && rm -f /etc/apt/sources.list.d/meganz.list /usr/share/keyrings/meganz.gpg \
 && apt-get purge -y curl gnupg && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/* /tmp/mega.key
# La sesión de MEGA vive en /root/.megaCmd (volumen persistente del usuario, permisos 700). Nunca se copia al servidor.
CMD ["mega-cmd-server"]
