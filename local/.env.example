# Evaluación local. No subir esta aplicación al hosting sin validar la arquitectura.
APP_URL=http://127.0.0.1:8010
BIND_HOST=127.0.0.1
PORT=8010
SESSION_SECURE=false
# Para recuperación real, configurar SMTP con STARTTLS. Nunca guardar credenciales en Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional: Adi usa esta API únicamente desde el backend. Si queda vacío, usa respuestas seguras locales.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Bloqueo de acceso (mínimo 15 minutos; valor admitido: 900 a 86400 segundos).
LOGIN_LOCKOUT_SECONDS=900

# Destino HTTPS de los QR; confirmar el dominio de la instalación publicada.
PUBLIC_APP_URL=https://ordenes-pro.ecuadorpcdoctor.com
# El aviso se oculta solo con producción habilitada, APP_URL HTTPS y cookie Secure.
APP_ENV=evaluation
PRODUCTION_ENABLED=false
# Ciudad del widget meteorológico (coordenadas del establecimiento; no del cliente).
WEATHER_CITY=Otavalo, EC
WEATHER_LATITUDE=0.2346
WEATHER_LONGITUDE=-78.2625
WEATHER_CONTACT=https://ecuadorpcdoctor.com

# En producción las condiciones vigentes son obligatorias automáticamente.
REQUIRE_SERVICE_TERMS=false

# Verificación adaptativa (no se muestra en accesos normales). Configurar ambas claves.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Con ambas claves, el inicio de sesión muestra la verificación siempre. Usar adaptive para exigirla solo tras fallos.
TURNSTILE_LOGIN_MODE=always
# Lista local opcional de contraseñas bloqueadas, una por línea. No se envían contraseñas a terceros.
PASSWORD_BLOCKLIST_FILE=

# Base remota libSQL/Turso (necesaria en Vercel). Vacío: se usa local/var/ordenes.sqlite3.
# El token es un secreto: definirlo solo en el entorno del hosting o en local/.env, nunca en Git.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
